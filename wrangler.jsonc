{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zoodefense",
  "compatibility_date": "2025-01-01",
  "observability": { "enabled": true },
  // 全部是靜態網頁（public/），沒有 Worker 程式、沒有資料庫
  "assets": { "directory": "./public", "html_handling": "auto-trailing-slash" },
  // 網址一律用 zoodefense.hunglun.com，不開 dev 網址。自訂網域用帳號層級 API 綁一次（templates/first-publish.sh domain）
  "workers_dev": false,
  "preview_urls": false
}
